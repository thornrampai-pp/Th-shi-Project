{
  "compilerOptions": {
    /* File Layout */
    "rootDir": "./src",                       
    "outDir": "./dist",                       

    /* Environment Settings */
    "target": "ES2022",                       
    "module": "CommonJS",                     
    "lib": ["ES2022"],                        
    "types": ["node"],                        

    /* Interop Constraints */
    "esModuleInterop": true,                  
    "forceConsistentCasingInFileNames": true, 

    /* Other Outputs */
    "sourceMap": true,                        
    "declaration": true,
    "declarationMap": true,

    /* Stricter Typechecking Options */
    "strict": true,                           
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Style & Code Quality Options */
    "noImplicitReturns": true,                
    "noUnusedLocals": true,                   
    "noUnusedParameters": true,               

    /* Recommended Options */
    "skipLibCheck": true                      
  },
  "include": ["src/**/*", "../generated/prisma/**/*"]
}