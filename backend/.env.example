# =====================================================================
# Copy to .env:  cp .env.example .env
# The defaults below match docker-compose.yml — `docker compose up -d --wait`
# then `npx prisma migrate dev` and you're running.
# =====================================================================

# ---------- Docker Compose (Postgres + Redis) ----------
# If Postgres/Redis already run locally on these ports, change the ports here AND in
# DATABASE_URL / REDIS_URL below (e.g. 5433 / 6380).
POSTGRES_USER=toshi
POSTGRES_PASSWORD=toshi
POSTGRES_DB=toshi_db
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- Required ----------
DATABASE_URL=postgresql://toshi:toshi@localhost:5432/toshi_db?schema=public
REDIS_URL=redis://localhost:6379
# At least 32 chars each, and different from each other. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------- Optional ----------
NODE_ENV=development
PORT=4000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# "false" disables cron jobs (daily history sync/snapshot, alerts, paper limit orders)
ENABLE_JOBS=true
# "false" skips the Yahoo price/FX backfill + snapshot rebuild on startup (e.g. offline)
ENABLE_HISTORY_BOOTSTRAP=true

# Slip OCR (uploadTransactionSlip, Discord /upload-slip) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Slip image storage — Cloudflare R2 (dashboard → R2 → Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Presigned read URL lifetime (seconds) and max upload size (bytes)
R2_PRESIGN_TTL_SECONDS=600
SLIP_MAX_BYTES=5242880
# Daily storage alert to ADMIN users' Discord (event SYSTEM_ALERT). Quota default = R2 free tier 10 GB.
R2_STORAGE_QUOTA_BYTES=10737418240
R2_STORAGE_ALERT_PERCENTS=80,90,100

# Discord slash commands — https://discord.com/developers/applications
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Reserved — FMP integration not implemented yet
FMP_API_KEY=
